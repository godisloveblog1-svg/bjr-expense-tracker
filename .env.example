# BJR Expense Tracker — environment variables
#
# Local setup: copy this file to `.env` and fill in the values.
# Vercel: Project → Settings → Environment Variables (add the same keys).
#
# NOTE: there is no admin-password variable any more. The admin panel signs in
# with real Supabase Auth (Authentication → Users in the Supabase dashboard),
# and only that signed-in session is allowed to change the books.

# ---- Required: Supabase project (Dashboard → Project Settings → API) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---- Optional: off-site backup to Google Sheets / Drive ----
# Leave empty to disable (the app works fine without it; the Supabase tables
# plus the audit trail are the source of truth).
# Setup steps are documented at the top of google-backup-script.js
VITE_GOOGLE_BACKUP_WEBHOOK_URL=

# ---- Optional: only for the GitHub Pages build ----
# The Pages workflow sets this automatically to /<repo-name>/.
# Vercel must NOT set it (the app is served from the root there).
# VITE_BASE_PATH=/bjr-expense-tracker/
